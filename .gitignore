cat > .gitignore <<'EOF'
# Environment variables and secrets
.env
.env.*
!.env.example

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Build output
frontend/dist/
backend/dist/

# Generated files
backend/uploads/
uploads/
*.log
logs/

# Operating system
.DS_Store

# Editors
.vscode/
.idea/

# Temporary files
*.tmp
*.swp
EOF*.zip
